# Odoo 20 target only; never reuse Odoo 19 credentials automatically.
ODOO_URL=https://your-odoo20-instance.odoo.com
ODOO_DB=your-odoo20-database
ODOO_USERNAME=your-user@example.com
# External API / RPC scope, not native MCP-only scope.
ODOO_API_KEY=replace-with-external-api-key
ODOO_VERIFY_SSL=true
ODOO_TIMEOUT=30
MCP_SAFETY_MODE=strict
MCP_TRANSPORT=stdio
# For HTTP: MCP_TRANSPORT=streamable-http and set MCP_API_KEY.
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# MCP_API_KEY=replace-with-separate-mcp-client-secret
